{
  "doctype": "DocType",
  "name": "Lead Finder Search",
  "module": "Custom",
  "custom": 1,
  "autoname": "field:uid",
  "title_field": "area",
  "fields": [
    {"fieldname": "uid", "fieldtype": "Data", "label": "UID", "reqd": 1, "unique": 1},
    {"fieldname": "city_key", "fieldtype": "Data", "label": "City Key", "reqd": 1, "search_index": 1},
    {"fieldname": "area_key", "fieldtype": "Data", "label": "Area Key"},
    {"fieldname": "term_key", "fieldtype": "Data", "label": "Term Key"},
    {"fieldname": "city", "fieldtype": "Data", "label": "City", "in_list_view": 1},
    {"fieldname": "area", "fieldtype": "Data", "label": "Area", "in_list_view": 1},
    {"fieldname": "term", "fieldtype": "Data", "label": "Term", "in_list_view": 1},
    {"fieldname": "pages", "fieldtype": "Int", "label": "Pages Searched", "in_list_view": 1},
    {"fieldname": "results_found", "fieldtype": "Int", "label": "Results Found"},
    {"fieldname": "run", "fieldtype": "Link", "label": "Last Run", "options": "Lead Finder Run"},
    {"fieldname": "done_at", "fieldtype": "Datetime", "label": "Done At"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Lead Finder", "read": 1}
  ]
}
